{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-literacy",
  // Same date as the ritchot-website Worker, which binds to this one.
  "compatibility_date": "2026-07-08",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The Worker strips the /courses/ai-literacy prefix before any asset lookup.
    "run_worker_first": true
  },
  // ritchot.me/courses/ai-literacy/* arrives through the website Worker's
  // service binding, so this Worker needs no public URL of its own.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "ai-literacy.ritchot.me/*", "zone_name": "ritchot.me" }]
}
